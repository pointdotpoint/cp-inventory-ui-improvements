// Generated by tools/build_pack_index.py from r6/tweaks and tools/pack_names.txt.
// Known mod packs by item ID prefix; unknown prefixes show in capitals.
module EquipmentEx

public class WardrobeTabsPackNames {

    public func Name(prefix: String) -> String {
        if Equals(prefix, "2bt") { return "2BT"; }
        if Equals(prefix, "axellysse") { return "axellysse"; }
        if Equals(prefix, "dusty") { return "Dusty"; }
        if Equals(prefix, "gabriela") { return "gabriela"; }
        if Equals(prefix, "kozsa") { return "Koza"; }
        if Equals(prefix, "kwek") { return "kwek"; }
        if Equals(prefix, "ntz") { return "ntz"; }
        if Equals(prefix, "tgp") { return "tottes"; }
        if Equals(prefix, "veegee") { return "Veegee"; }
        if Equals(prefix, "yv") { return "VOID"; }
        return "";
    }

}
