    // A shipped language's texts, put over English (an alias uses its target's).
    protected func DefineShipped(lang: String) {
        if Equals(lang, "ar-ar") {
            this.DefineArAr();
        }
        if Equals(lang, "cz-cz") {
            this.DefineCzCz();
        }
        if Equals(lang, "de-de") {
            this.DefineDeDe();
        }
        if Equals(lang, "es-es") {
            this.DefineEsEs();
        }
        if Equals(lang, "es-mx") {
            this.DefineEsMx();
        }
        if Equals(lang, "fr-fr") {
            this.DefineFrFr();
        }
        if Equals(lang, "hu-hu") {
            this.DefineHuHu();
        }
        if Equals(lang, "it-it") {
            this.DefineItIt();
        }
        if Equals(lang, "jp-jp") {
            this.DefineJpJp();
        }
        if Equals(lang, "kr-kr") {
            this.DefineKrKr();
        }
        if Equals(lang, "pl-pl") {
            this.DefinePlPl();
        }
        if Equals(lang, "pt-br") {
            this.DefinePtBr();
        }
        if Equals(lang, "ru-ru") {
            this.DefineRuRu();
        }
        if Equals(lang, "th-th") {
            this.DefineThTh();
        }
        if Equals(lang, "tr-tr") {
            this.DefineTrTr();
        }
        if Equals(lang, "ua-ua") {
            this.DefineUaUa();
        }
        if Equals(lang, "zh-cn") {
            this.DefineZhCn();
        }
        if Equals(lang, "zh-tw") {
            this.DefineZhTw();
        }
    }
